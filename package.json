{
  "name": "phase",
  "version": "0.0.1",
  "description": "Lifecycle-aware animation infrastructure for the web.",
  "author": "Vercel",
  "license": "MIT",
  "repository": {
    "url": "git+https://github.com/vercel-labs/phase.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --check",
    "format:fix": "oxfmt .",
    "prepublishOnly": "pnpm build",
    "postinstall": "lefthook install || true",
    "size": "size-limit",
    "size:why": "size-limit --why",
    "validate": "pnpm run --parallel '/^(typecheck|lint|format|test)$/'"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "dependencies": {
    "nostics": "^1.1.4"
  },
  "devDependencies": {
    "@size-limit/esbuild-why": "^12.1.0",
    "@size-limit/preset-small-lib": "^12.1.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.0",
    "@types/node": "25.6.0",
    "@types/react": "19.2.10",
    "@types/react-dom": "19.2.3",
    "jsdom": "23.2.0",
    "lefthook": "2.1.5",
    "oxfmt": "0.44.0",
    "oxlint": "1.59.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "size-limit": "^12.1.0",
    "tsdown": "0.21.7",
    "typescript": "6.0.2",
    "vitest": "4.1.4"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./ease": {
      "types": "./dist/ease.d.ts",
      "default": "./dist/ease.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    }
  },
  "engines": {
    "node": "24.x"
  },
  "size-limit": [
    {
      "name": "core (full)",
      "path": "dist/index.js",
      "import": "*"
    },
    {
      "name": "ease utils",
      "path": "dist/ease.js",
      "import": "{ easeOutCubic, lerp, clamp, remap }"
    },
    {
      "name": "createLoop",
      "path": "dist/index.js",
      "import": "{ createLoop }"
    },
    {
      "name": "createSight",
      "path": "dist/index.js",
      "import": "{ createSight }"
    },
    {
      "name": "createTicker",
      "path": "dist/index.js",
      "import": "{ createTicker }"
    },
    {
      "name": "react (full)",
      "path": "dist/react.js",
      "import": "*",
      "ignore": [
        "react",
        "react-dom"
      ]
    },
    {
      "name": "react useLoop",
      "path": "dist/react.js",
      "import": "{ useLoop }",
      "ignore": [
        "react",
        "react-dom"
      ]
    },
    {
      "name": "react Presence + usePresence",
      "path": "dist/react.js",
      "import": "{ Presence, usePresence }",
      "ignore": [
        "react",
        "react-dom"
      ]
    }
  ],
  "packageManager": "pnpm@10.32.1"
}
