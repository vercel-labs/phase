{
  "name": "@usephase/workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r --filter phase build",
    "test": "pnpm -r --filter phase test && vitest run",
    "typecheck": "pnpm -r --filter phase typecheck && tsc --noEmit",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --check",
    "format:fix": "oxfmt .",
    "size": "pnpm -r --filter phase size",
    "size:readme": "node scripts/update-size-table.mjs",
    "goldens": "node scripts/skill/regen-goldens.mjs",
    "prepare": "lefthook install || true",
    "validate": "pnpm --filter @usephase/workspace run --parallel '/^(typecheck|lint|format|test|skill:check)$/'",
    "skill:check": "node scripts/skill/check-coverage.mjs && node scripts/skill/check-scan-sync.mjs",
    "skill:build": "tsdown -c tsdown.scanner.config.ts && node scripts/skill/build-metadata.mjs && node scripts/skill/sync-scan-docs.mjs",
    "skill:package": "node scripts/skill/package.mjs"
  },
  "devDependencies": {
    "@size-limit/preset-small-lib": "12.1.0",
    "@types/node": "25.6.0",
    "lefthook": "2.1.5",
    "oxfmt": "0.44.0",
    "oxlint": "1.59.0",
    "tsdown": "0.21.7",
    "typescript": "6.0.2",
    "vitest": "4.1.4"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@10.32.1"
}
