{
  "name": "@usephase/workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "test:root": "vitest run --globals scripts/check-package-version.spec.mjs",
    "typecheck": "turbo run typecheck",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --check",
    "format:fix": "oxfmt .",
    "size": "turbo run size",
    "size:readme": "node scripts/update-size-table.mjs",
    "goldens": "turbo run goldens",
    "prepare": "lefthook install || true",
    "validate": "pnpm --filter @usephase/workspace run --parallel '/^(lint|format)$/' && turbo run validate && pnpm skill:package",
    "skill:check": "turbo run skill:check",
    "skill:build": "turbo run skill:build",
    "skill:package": "turbo run skill:package"
  },
  "devDependencies": {
    "@size-limit/preset-small-lib": "12.1.0",
    "lefthook": "2.1.5",
    "oxfmt": "0.44.0",
    "oxlint": "1.59.0",
    "turbo": "2.10.11",
    "vitest": "4.1.4"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@10.32.1"
}
