{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": ["tsconfig.base.json"],
  "remoteCache": {
    "enabled": false
  },
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^test", "//#test:root"]
    },
    "test:browser": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "size": {},
    "skill:check": {
      "cache": false
    },
    "skill:build": {
      "cache": false
    },
    "skill:package": {
      "dependsOn": ["skill:build"],
      "cache": false
    },
    "goldens": {
      "cache": false
    },
    "validate": {
      "dependsOn": ["build", "typecheck", "test", "size", "skill:check"]
    },
    "//#test:root": {
      "dependsOn": ["@usephase/react#build"]
    },
    "@usephase/examples#typecheck": {
      "dependsOn": ["^build", "^typecheck"]
    },
    "@usephase/react#test": {
      "dependsOn": ["^build", "^test", "//#test:root"]
    },
    "@usephase/react#typecheck": {
      "dependsOn": ["^build", "^typecheck"]
    },
    "@usephase/cli#build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/skill/scanner/**",
        "$TURBO_ROOT$/skills/phase/metadata.json"
      ],
      "outputs": ["dist/**"]
    },
    "@usephase/cli#test": {
      "dependsOn": ["build", "^test", "//#test:root"]
    },
    "@usephase/codemod#test": {
      "dependsOn": ["build", "^test"]
    },
    "@usephase/skill#test": {
      "cache": false
    }
  }
}
