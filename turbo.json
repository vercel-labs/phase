{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": ["tsconfig.base.json"],
  "remoteCache": {
    "enabled": false
  },
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^test", "//#test:root"]
    },
    "size": {},
    "skill:check": {
      "cache": false
    },
    "skill:build": {
      "cache": false
    },
    "skill:package": {
      "dependsOn": ["skill:build"],
      "cache": false
    },
    "goldens": {
      "cache": false
    },
    "validate": {
      "dependsOn": ["build", "typecheck", "test", "size", "skill:check"]
    },
    "//#test:root": {},
    "@usephase/examples#typecheck": {
      "dependsOn": ["phase#build", "^typecheck"]
    },
    "@usephase/skill#test": {
      "cache": false
    }
  }
}
