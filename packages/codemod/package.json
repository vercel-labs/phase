{
  "name": "@usephase/codemod",
  "version": "0.1.0",
  "description": "Versioned migrations for phase packages",
  "author": "Vercel",
  "license": "MIT",
  "repository": {
    "url": "git+https://github.com/vercel-labs/phase.git",
    "directory": "packages/codemod"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "usephase-codemod": "./dist/usephase-codemod.mjs"
  },
  "files": [
    "codemods",
    "dist",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown",
    "readme:check": "node scripts/generate-readme.mjs --check",
    "readme:fix": "node scripts/generate-readme.mjs --write",
    "test": "pnpm readme:check && vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "commander": "15.0.0",
    "jscodeshift": "17.4.0"
  },
  "devDependencies": {
    "@types/jscodeshift": "17.3.0",
    "@types/node": "25.6.0",
    "tsdown": "0.21.7",
    "typescript": "6.0.2",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
