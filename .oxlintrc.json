{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/npm/oxlint/configuration_schema.json",
  "ignorePatterns": [
    "packages/skill/evals/**",
    "skills/phase/scripts/scan.mjs"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "pedantic": "off",
    "perf": "warn",
    "style": "off",
    "restriction": "error",
    "nursery": "off"
  },
  "rules": {
    "no-unused-vars": "warn",
    "no-console": "off",
    "no-undefined": "off",
    "typescript/explicit-function-return-type": "off",
    "no-rest-spread-properties": "off",
    "no-use-before-define": "off",
    "no-optional-chaining": "off",
    "no-async-await": "off",
    "no-plusplus": "off",
    "prefer-template": "error"
  },
  "overrides": [
    {
      "files": [
        "packages/core/src/**/*.browser.spec.ts",
        "packages/core/src/**/*.browser.spec.tsx",
        "packages/react/src/**/*.browser.spec.ts",
        "packages/react/src/**/*.browser.spec.tsx"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "(^|/)__mocks__/|^@usephase/testing/(?!browser$)",
                "message": "Browser specs must exercise real browser APIs."
              }
            ]
          }
        ]
      }
    }
  ]
}
